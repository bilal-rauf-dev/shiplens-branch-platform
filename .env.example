# Copy to .env for Docker Compose. Set secrets locally; .env is never included in images.

# Required Django signing secret: replace this placeholder with a long random value.
SECRET_KEY=replace-with-a-long-random-local-development-key
# Inside Compose, use the db service name (not localhost). Match POSTGRES_* below.
DATABASE_URL=postgres://postgres:postgres@db:5432/shiplens
# Comma-separated public hostnames, without schemes or ports.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated trusted HTTPS origins; HTTP is allowed for local development.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Render supplies this hostname automatically; it is appended to hosts and HTTPS origins.
RENDER_EXTERNAL_HOSTNAME=

# Compose selects dev settings. Standalone containers default to prod settings.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Enable demo seeding only when desired; absent seed_demo is safely skipped.
DEMO_MODE=false
# Set a demo password before enabling demo accounts in P2; unused before then.
DEMO_PASSWORD=
# Python logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Local PostgreSQL container values; change the password outside local development.
POSTGRES_DB=shiplens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Internal listening port; Compose publishes it on localhost port 8000.
PORT=8000
# Number of gunicorn workers in a production container.
WEB_CONCURRENCY=2
# Render provides this commit hash. When empty, health uses the image's GIT_SHA.
RENDER_GIT_COMMIT=
# Image version fallback. Omit this variable to retain a docker build --build-arg GIT_SHA value.
# GIT_SHA=dev
