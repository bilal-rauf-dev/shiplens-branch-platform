{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8000/en/",
        "http://localhost:8000/ur/",
        "http://localhost:8000/en/get-involved/",
        "http://localhost:8000/en/branches/",
        "http://localhost:8000/en/events/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "skipAudits": ["is-on-https"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9, "aggregationMethod": "median"}],
        "categories:accessibility": ["error", {"minScore": 0.9, "aggregationMethod": "median"}],
        "categories:best-practices": ["error", {"minScore": 0.9, "aggregationMethod": "median"}],
        "categories:seo": ["error", {"minScore": 0.9, "aggregationMethod": "median"}]
      }
    }
  }
}
